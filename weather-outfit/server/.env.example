# ── 서버 ──
PORT=4000
# 앱에서 접근할 수 있는 서버 공개 주소 (OAuth redirect_uri 생성에 사용)
PUBLIC_BASE_URL=http://localhost:4000
# JWT 서명 키 (32자 이상 임의 문자열)
JWT_SECRET=change-me-to-a-long-random-string-xxxxxxxx
# 로그인 완료 후 돌아갈 수 있는 앱 주소 접두어 (콤마 구분) — 오픈 리다이렉트 방지
APP_REDIRECT_ALLOWLIST=weatherfit://,exp://,http://localhost:8081

# ── 공공데이터포털(data.go.kr) 일반 인증키 (Decoding 키) ──
# 기상청 단기예보, 기상청 생활기상지수, 에어코리아 대기오염정보/측정소정보 활용신청 필요.
# 비워두면 데모 데이터로 동작합니다.
DATA_GO_KR_SERVICE_KEY=

# ── 카카오 (developers.kakao.com) ──
# REST API 키: 카카오 로그인 + 좌표→행정구역 변환(자외선지수 지역코드/지역명)에 함께 사용
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# ── 네이버 (developers.naver.com) ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 구글 (console.cloud.google.com, 웹 애플리케이션 OAuth 클라이언트) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
